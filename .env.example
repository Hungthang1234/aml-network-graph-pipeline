# Example environment configuration for local development.
# Replace placeholders with real values in your local .env file only.

# Application
APP_ENV=development
LOG_LEVEL=INFO

# Database (example placeholders)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=aml_pipeline
DB_USER=example_user
DB_PASSWORD=change_me

# AWS (example placeholders)
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=EXAMPLE_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=EXAMPLE_SECRET_ACCESS_KEY
S3_BUCKET=example-aml-bucket

# Airflow / API examples
AIRFLOW_HOME=./airflow
FLASK_ENV=development
